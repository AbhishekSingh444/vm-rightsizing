{
  "attribution": {
    "commits": false,
    "pullRequests": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)"
    ]
  }
}
