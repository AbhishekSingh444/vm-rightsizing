# Datasets are large and licensed -- never commit them. Everything under
# data/ stays local (downloads, unzipped traces, staged copies) except the
# one small example file the tests and README use.
data/*
!data/sample_vm.csv
*.zip

# Results: track small summary tables, data dictionaries and every
# run_config.json / *_config.json beside them, so each number in the report
# traces to committed parameters. Anything else under results/ (logs, plots,
# pickles) stays out.
results/**
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.md
!results/.gitkeep
# Captured console output per rubric step, and the Rnd preflight report.
!results/**/evidence/*.txt
!results/rnd/preflight.txt

# Per-VM tables (one row per VM, fleet-wide) are large and regenerable.
# The results/**/ prefix covers every subdirectory, including results/rnd/.
results/**/per_vm_results.csv
results/**/dataset_report.csv
results/**/gpd_shapes.csv
results/**/theta_per_vm.csv
results/**/recommendations.csv
results/**/evt_diagnostics.csv
results/**/capacity_glitch_scan.csv
results/**/below_catalog_floor_scan.csv
results/**/idle_vs_nonidle_memory_reclamation.csv
results/**/diag_cpu_shapes_idle.csv
results/**/*per_vm*.csv

# Regenerable outputs.
testbed/manifests/
__pycache__/
*.pyc
.venv/

# Personal workspace and AI configs
.claude/
CLAUDE.md
TASKS.md
ENVIRONMENT_NOTES.md

# evidence/ IS committed -- it is the graded deliverable.
!evidence/
cols.txt

# Presentation notes, paper template and similarity report -- not part of
# the project.
script.md
file_guide.md
paper/IEEE_Conference_Template*.pdf
paper/*_similarity.pdf

# Slide decks: only the final Review 3 deck is part of the deliverable.
# Earlier review decks and other teams' reference decks stay local.
paper/*.pptx
!paper/Abhishek_Singh_P10_Review3.pptx
~$*.pptx

# make demo / demo-vm output -- regenerable.
demo_out/
# README tells users to regenerate tables here, so committed results stay intact.
my_results/

# Editor and OS clutter.
.vscode/
.idea/
node_modules/
.DS_Store
Thumbs.db
desktop.ini

# Slide decks stay local -- not part of the published repo.
*.pptx
