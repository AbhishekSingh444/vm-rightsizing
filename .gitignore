# The published repo holds only what is needed to rebuild the project and
# serve the website: code, tests, testbed, Makefile and website/. Generated
# outputs, write-ups and the dataset stay local.

# Datasets are large and licensed -- never commit them. Everything under
# data/ stays local (downloads, unzipped traces, staged copies) except the
# one small example file the tests and README use.
data/*
!data/sample_vm.csv
*.zip

# Generated outputs -- regenerated by `make`. The empty directories are kept
# so make targets that write into them work on a fresh clone.
results/*
!results/.gitkeep
evidence/*
!evidence/.gitkeep
figures/
testbed/manifests/
demo_out/
# README tells users to regenerate tables here.
my_results/
__pycache__/
*.pyc
.venv/

# Write-ups, slide decks and notes -- not part of the code.
paper/
docs/
*.pptx
~$*.pptx
script.md
file_guide.md
cols.txt

# Personal workspace and AI configs
.claude/
CLAUDE.md
TASKS.md
ENVIRONMENT_NOTES.md

# Editor and OS clutter.
.vscode/
.idea/
node_modules/
.DS_Store
Thumbs.db
desktop.ini
